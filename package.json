{
  "name": "agentic-ai-live-labs",
  "private": true,
  "type": "module",
  "scripts": {
    "lab": "bun scripts/lab.ts",
    "test": "bun test",
    "readable": "bun scripts/readable.ts",
    "check": "bun test && bun scripts/readable.ts && bun scripts/plain-english.ts && bun scripts/plain-code.ts && bun scripts/commands.ts && bun scripts/path.ts --check && bun scripts/readme.ts --check && bun scripts/glossary.ts && bun scripts/stuck.ts && bun scripts/mermaid.ts && bun scripts/mutate.ts && bunx tsc -p .",
    "path": "bun scripts/path.ts",
    "sync": "bun scripts/readme.ts --write && bun scripts/path.ts --write",
    "mutate": "bun scripts/mutate.ts",
    "plain": "bun scripts/plain-english.ts",
    "verify": "bun scripts/verify.ts",
    "verify:live": "bun scripts/verify.ts --live",
    "glossary": "bun scripts/glossary.ts",
    "mermaid": "bun scripts/mermaid.ts",
    "stuck": "bun scripts/stuck.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "plainEnglish": {
    "grade": 6,
    "longest": 18,
    "average": 12
  },
  "dependencies": {
    "compromise": "^14.20.0",
    "gpt-tokenizer": "^4.1.2",
    "minisearch": "^7.2.0"
  }
}
